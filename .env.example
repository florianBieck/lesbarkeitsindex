COMPOSE_PROJECT_NAME=lesbarkeitsindex-prod

# Database
DATABASE_URL=postgresql://admin:admin@localhost:5432/lesbarkeitsindex?schema=public

# R NLP sidecar (Docker only — use localhost for local dev)
R_SIDECAR_URL=http://localhost:8787

# Default configuration (optional): path to a config.json with alpha and the four
# WK weights, read on every request. Unset or no file there: built-in defaults
# (0.3 and 50 / 25 / 12.5 / 12.5). An invalid file stops calculation. Example:
# {"alpha": 0.3, "weightComplexSyllables": 50, "weightMultiMemberedGraphemes": 25,
#  "weightRareGraphemes": 12.5, "weightConsonantClusters": 12.5,
#  "impressumUrl": "https://example.org/impressum", "datenschutzUrl": "https://example.org/datenschutz"}
# CONFIG_FILE=./config.json

# Auth — IMPORTANT: Use a strong random value in production (openssl rand -base64 32)
BETTER_AUTH_SECRET=dev-secret
BETTER_AUTH_URL=http://localhost:3000
