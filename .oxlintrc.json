{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/generated/**",
    "**/.nuxt/**",
    "**/.output/**"
  ],
  "overrides": [
    {
      // The SPA imports through `@/` whenever an import leaves the file's directory.
      "files": ["apps/frontend/**"],
      "plugins": ["import"],
      "rules": {
        "import/no-relative-parent-imports": "error"
      }
    }
  ]
}
