# The backend serves the API and the built SPA (ADR 0007). Each build stage copies
# only its own sources, so a frontend-only change doesn't rerun `nest build` and
# a backend-only change doesn't rerun `vite build`.

# ---------- Base image ----------
FROM node:26-alpine AS base
WORKDIR /app

# Enable corepack for pnpm (version resolved from the root packageManager field).
# Node 25+ no longer bundles corepack, so it comes from npm.
RUN npm install -g corepack@0.36.0 && corepack enable

# Install OpenSSL for Prisma
RUN apk add --no-cache openssl

# ---------- Backend dependencies ----------
FROM base AS deps
# Copy lockfile and the workspace package.json files for proper resolution
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/backend/package.json ./apps/backend/package.json
COPY apps/backend/prisma/schema.prisma ./apps/backend/prisma/schema.prisma
COPY apps/backend/prisma.config.ts ./apps/backend/prisma.config.ts
COPY packages/api-client/package.json ./packages/api-client/package.json

RUN pnpm install --frozen-lockfile

# ---------- Backend build ----------
FROM deps AS build
COPY apps/backend ./apps/backend

# Generate Prisma client
ENV DATABASE_URL="IGNORE"
WORKDIR /app/apps/backend
RUN pnpm exec prisma generate

# Build NestJS with SWC
RUN pnpm exec nest build
WORKDIR /app

# ---------- SPA build ----------
FROM base AS spa
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.json ./
COPY apps/frontend/package.json ./apps/frontend/package.json
COPY packages/api-client/package.json ./packages/api-client/package.json

RUN pnpm install --frozen-lockfile

COPY packages/api-client ./packages/api-client
COPY apps/frontend ./apps/frontend
RUN pnpm --filter @lesbarkeitsindex/frontend run build

# ---------- Runtime image ----------
FROM base AS runner
WORKDIR /app

# Copy root workspace config
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./

# Bake the packageManager-pinned pnpm into the runtime image so the start
# CMD (pnpm exec prisma migrate deploy) never downloads pnpm at container start
RUN corepack prepare --activate

# Copy built backend and its dependencies
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/apps/backend/dist ./apps/backend/dist
COPY --from=build /app/apps/backend/node_modules ./apps/backend/node_modules
COPY --from=build /app/apps/backend/package.json ./apps/backend/package.json
COPY --from=build /app/apps/backend/prisma ./apps/backend/prisma
COPY --from=build /app/apps/backend/prisma.config.ts ./apps/backend/prisma.config.ts

# The built SPA, where AppModule looks for it (apps/backend/dist/../../frontend/dist)
COPY --from=spa /app/apps/frontend/dist ./apps/frontend/dist

# Environment
ENV NODE_ENV=production
ENV PORT=3000
EXPOSE 3000

# Run DB migrations, then start the app
CMD ["sh", "-c", "cd apps/backend && pnpm exec prisma migrate deploy && node dist/main.js"]
