{
  // Code that runs in Node: the tool configs and the Playwright specs.
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "types": ["node"]
  },
  "include": [
    "vite.config.ts",
    "playwright.config.ts",
    "playwright.smoke.config.ts",
    "e2e/**/*.ts",
    "smoke/**/*.ts"
  ]
}
